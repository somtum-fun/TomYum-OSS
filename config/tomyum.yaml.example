# TomYum optional configuration overlay (tomyum.yaml.example).
#
# Copy this file to `tomyum.yaml` and edit it for your deployment.
# `tomyum.yaml` is gitignored — it holds your local/deployment-specific settings.
#
# This file is an OPTIONAL overlay on top of appsettings.json + appsettings.{Env}.json
# + environment variables. See memories/architecture/decisions/0008-config-strategy.md.
#
# Precedence (lowest to highest):
#   appsettings.json  <  appsettings.{Environment}.json  <  tomyum.yaml  <  TOMYUM_* env vars
#
# Secrets (DB passwords, S3 keys, OAuth signing keys) MUST NOT live here.
# Inject them via environment variables / k8s secrets. Keys below are placeholders.

server:
  # Public domain the osu! client connects to (c.<domain>, osu.<domain>, etc.).
  domain: "tomyum.example"
  # Bind address for the ASP.NET host inside the pod.
  bind: "http://0.0.0.0:8080"

database:
  # Enable MySQL persistence. false = in-memory only (for quick local dev without a DB).
  enabled: true
  # MySQL host. Password comes from TOMYUM_DATABASE__PASSWORD env var.
  host: "mysql"
  port: 3306
  name: "tomyum"
  user: "tomyum"

osu:
  # osu! v1 API key for beatmap metadata lookup.
  # Leave empty to use the keyless osu.direct mirror (works without a key).
  # Get a key at https://old.ppy.sh/p/api
  apiKey: ""

replays:
  # Directory where replay .osr files are stored (relative to the working directory).
  path: "data/replays"

redis:
  # Online state, pub/sub fan-out, leaderboard caches. See ADR-0003.
  configuration: "redis:6379"

irc:
  # IRC bridge for external bots. See memories/protocols/irc.md.
  enabled: true
  port: 6667

performance:
  # PP/difficulty engine. native = in-process ppy.osu.Game.Rulesets (ADR-0005 default).
  # sidecar = call out to a rosu-pp service if throughput demands it later.
  engine: "native"
  sidecarUrl: ""

# --------------------------------------------------------------------------
# Storage: object storage for avatars, screenshots, replays, beatmaps, sets.
# Model (ADR-0006 / memories/features/storage.md):
#   - storage.enabled: master switch. false => ALL asset storage disabled.
#   - storage.providers: named provider instances; each has its own enabled flag.
#   - storage.defaultProviders: write-fan-out + read source for asset types with
#     no explicit route. First entry serves reads; all entries receive writes.
#   - storage.routes: per-asset-type routing. Each route has:
#       enabled  - per-asset-type on/off switch
#       writeTo  - list of providers an upload is replicated to (one, some, or ALL)
#       readFrom - the single provider used to serve reads (defaults to writeTo[0])
#
# This is the "choose where each asset lives" model: host an asset on R2 only,
# on OVH only, on local only, on several at once, or on all of them — per asset
# type — by editing writeTo/readFrom. No code change required.
# --------------------------------------------------------------------------
storage:
  enabled: true
  # Asset types without an explicit route below are written to all of these and
  # read from the first. Set to a single provider for a simple single-target setup.
  defaultProviders: ["local"]

  providers:
    local:
      enabled: true
      kind: "Local"
      bucket: "/var/lib/tomyum/storage"      # root folder for local static files

    r2:
      enabled: false
      kind: "CloudflareR2"
      bucket: "tomyum-public"
      endpoint: "https://<accountid>.r2.cloudflarestorage.com"
      region: "auto"
      publicBaseUrl: "https://cdn.tomyum.example"
      # accessKey / secretKey: inject via TOMYUM_STORAGE__PROVIDERS__R2__ACCESSKEY etc.

    ovh-s3:
      enabled: false
      kind: "OvhS3"
      bucket: "tomyum-bulk"
      endpoint: "https://s3.<region>.io.cloud.ovh.net"
      region: "gra"

    aws-s3:
      enabled: false
      kind: "AwsS3"
      bucket: "tomyum-aws"
      region: "us-east-1"

    azure-blob:
      enabled: false
      kind: "AzureBlob"
      bucket: "tomyum"                        # container name
      endpoint: "https://<account>.blob.core.windows.net"

  # Per-asset-type routing. Asset type names mirror TomYum.Storage.AssetType:
  # Avatar, Screenshot, Replay, Beatmap, BeatmapSet, BeatmapMedia.
  # Examples below show single-target, multi-target, and replicate-to-all.
  routes:
    # Served from R2 (CDN), but also replicated to OVH for durability.
    Avatar:
      enabled: true
      writeTo: ["r2", "ovh-s3"]
      readFrom: "r2"
    # Single provider only.
    Screenshot:
      enabled: true
      writeTo: ["r2"]
    # Cold/bulk on OVH only.
    Replay:
      enabled: true
      writeTo: ["ovh-s3"]
    # Hosted on ALL configured providers; reads come from R2.
    BeatmapSet:
      enabled: true
      writeTo: ["r2", "ovh-s3", "aws-s3", "azure-blob", "local"]
      readFrom: "r2"
    # Beatmap (.osu) and BeatmapMedia fall back to defaultProviders (local) here.

# --------------------------------------------------------------------------
# Plugins: runtime drop-ins from the plugins/ directory. DAN Mode and Session
# ship as plugins (ADR-0007). Each plugin's own config lives under plugins.<id>.
# --------------------------------------------------------------------------
plugins:
  directory: "plugins"
  # Whether to compile loose folder/code.cs plugins at runtime (Roslyn) in addition
  # to loading compiled .dll plugins.
  allowLooseSource: true

  # Per-plugin config blocks go here: plugins.<plugin-id> with whatever settings
  # that plugin reads. See each plugin's README for its config schema.
  # Example:
  #   "your.plugin.name":
  #     enabled: true
  #     someOption: value

