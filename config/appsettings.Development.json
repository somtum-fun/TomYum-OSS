{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",

  "// note": "Sample development config. Secrets (DB password, S3 keys) come from .env / env vars, never this file. See memories/architecture/decisions/0008-config-strategy.md.",

  "Server": {
    "Domain": "example.com",
    "Mysql": {
      "ConnectionString": "Server=localhost;Port=3306;Database=tomyum;User=tomyum;Password=__FROM_ENV__;"
    },
    "Redis": {
      "Configuration": "localhost:6379"
    }
  },

  "Irc": {
    "Enabled": true,
    "Port": 6667,
    "ServerName": "example.com"
  },

  "Performance": {
    "Engine": "NativeCSharp",
    "SidecarUrl": null
  },

  "Plugins": {
    "Directory": "plugins",
    "Enabled": true
  },

  "Storage": {
    "Enabled": true,
    "DefaultProvider": "local",
    "Providers": {
      "local": {
        "Enabled": true,
        "Kind": "Local",
        "Bucket": "./data/storage"
      }
    },
    "Routes": {}
  }
}
