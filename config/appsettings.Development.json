{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",

  "// note": "Dev config. Secrets (DB password, osu! API key) come from .env / env vars, never here. See memories/architecture/decisions/0008-config-strategy.md.",

  "Server": {
    "Domain": "example.com"
  },

  "Database": {
    "Enabled": true,
    "Host": "127.0.0.1",
    "Port": 3306,
    "Name": "tomyum",
    "User": "tomyum"
  },

  "Redis": {
    "Configuration": "localhost:6379"
  },

  "Irc": {
    "Enabled": true,
    "Port": 6667,
    "ServerName": "example.com"
  },

  "Performance": {
    "Engine": "NativeCSharp",
    "SidecarUrl": null
  },

  "Plugins": {
    "Directory": "plugins",
    "Enabled": true
  },

  "Replays": {
    "Path": "data/replays"
  },

  "Storage": {
    "Enabled": true,
    "DefaultProvider": "local",
    "Providers": {
      "local": {
        "Enabled": true,
        "Kind": "Local",
        "Bucket": "./data/storage"
      }
    },
    "Routes": {}
  }
}
