# TomYum environment variables (sample). Copy to .env and fill in real values.
# These map onto configuration keys using the ASP.NET double-underscore convention
# with the TOMYUM_ prefix. Env vars OVERRIDE appsettings/tomyum.yaml (ADR-0008).
# NEVER commit a filled-in .env — secrets only ever live in env / k8s secrets.

# --- Core ---
ASPNETCORE_ENVIRONMENT=Development
TOMYUM_SERVER__DOMAIN=tomyum.example

# --- MySQL ---
TOMYUM_DATABASE__ENABLED=true
TOMYUM_DATABASE__HOST=mysql
TOMYUM_DATABASE__PORT=3306
TOMYUM_DATABASE__NAME=tomyum
TOMYUM_DATABASE__USER=tomyum
TOMYUM_DATABASE__PASSWORD=change-me
# osu-web's database on the same server (usually `osu`). When set, accounts live in osu-web's
# phpbb_users so one login works on the website and in-game. See docs/osu-web.md.
TOMYUM_DATABASE__OSUWEBNAME=
# osu-web's ES_INDEX_PREFIX, if it sets one (new scores are queued for its score indexer under it).
TOMYUM_DATABASE__OSUWEBINDEXPREFIX=

# --- osu-web InterOp (optional; docs/osu-web.md) ---
# Lets osu-web record medal unlocks with activity entries and index in-game sign-ups for search.
# URL as TomYum reaches osu-web (http://nginx inside osu-web's compose network); the secret is
# osu-web's SHARED_INTEROP_SECRET.
TOMYUM_OSUWEB__INTEROPURL=
TOMYUM_OSUWEB__INTEROPSECRET=

# --- Redis ---
TOMYUM_REDIS__CONFIGURATION=redis:6379

# --- Replays ---
TOMYUM_REPLAYS__PATH=data/replays

# --- osu! v1 API (optional) ---
# Beatmap metadata/status lookup. With a key, requests go to old.ppy.sh; leave it
# empty to use the keyless osu.direct mirror. Get a key at https://old.ppy.sh/p/api.
TOMYUM_OSU__APIKEY=

# --- osu! API v2 (optional) ---
# Beatmap descriptions and nominators on the website (the v1 API doesn't have them). Create an
# OAuth application at https://osu.ppy.sh/home/account/edit#oauth (any name, callback URL can be
# empty) and put its client ID and secret here. The client credentials grant, public scope only.
TOMYUM_OSU__CLIENTID=
TOMYUM_OSU__CLIENTSECRET=

# --- Storage secrets (only the providers you enable need these) ---
TOMYUM_STORAGE__PROVIDERS__R2__ACCESSKEY=
TOMYUM_STORAGE__PROVIDERS__R2__SECRETKEY=
TOMYUM_STORAGE__PROVIDERS__OVH-S3__ACCESSKEY=
TOMYUM_STORAGE__PROVIDERS__OVH-S3__SECRETKEY=

# --- Plugin secrets (e.g. DAN Mode Discord webhooks) ---
TOMYUM_PLUGINS__TOMYUM_DAN-MODE__SESSIONWEBHOOKURL=
TOMYUM_PLUGINS__TOMYUM_DAN-MODE__FAILWEBHOOKURL=
TOMYUM_PLUGINS__TOMYUM_DAN-MODE__SUCCESSWEBHOOKURL=
