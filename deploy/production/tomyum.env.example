# TomYum settings beyond what docker-compose.yml sets from .env (config/.env.example lists them
# all). Copy to tomyum.env. The defaults are fine to start with.
TOMYUM_REPLAYS__PATH=data/replays

# The server's name in BanchoBot's posts, !version and the in-game restart notice
# ("example · TomYum 0.3.0-dev is up"); the website's is TOMYUM_SERVER_NAME in osu-web.env.
# Empty: TomYum.
TOMYUM_SERVER__NAME=

# Last.fm scrobbling (players connect it in the website's account settings). Make an API account at
# https://www.last.fm/api/account/create with the callback https://osu.<domain>/home/account/lastfm/callback.
# Empty: no Last.fm.
TOMYUM_LASTFM__APIKEY=
TOMYUM_LASTFM__APISECRET=

# osu!stable device verification (as osu.ppy.sh): logging in from a new device is refused until the
# player confirms it on the website (osu.<domain>/p/verify); an account's first device is trusted.
# Leave it off to let original old builds (2008-2015) connect: only b20151228 and later can confirm a
# device, unless your own patched clients send "tomyum-verify" (docs/old-clients.md).
# TOMYUM_CLIENTVERIFICATION__ENABLED=true

# Ranking (the old server's rule): a difficulty that becomes ranked or approved starts with an empty
# leaderboard, its scores deleted in every mode (vanilla, relax, autopilot), stable and lazer, here
# and on the website. false keeps the scores (they get pp instead).
# TOMYUM_RANKING__CLEARSCORESONRANK=true

# Builds before b20151228 can't be asked to verify (unless patched to send "tomyum-verify", see
# docs/old-clients.md). Unverified (default): they log in without the check. Refuse: they're refused
# when their device needs verifying, with a link to the website and to DOWNLOADSURL
# (default https://osu.<domain>/home/download).
# TOMYUM_CLIENTVERIFICATION__OLDCLIENTS=Unverified
# TOMYUM_CLIENTVERIFICATION__DOWNLOADSURL=

# BanchoBot's user id (default 3, as on osu!). A server imported from bancho.py with
# tools/ImportBanchoPy may keep its owner at 3 and put the bot at 2; set it before the first start,
# and the same value as BANCHO_BOT_USER_ID in osu-web.env (and the spectator service).
# TOMYUM_BANCHO__BOTUSERID=3
# The bot's name (BanchoBot unless set), e.g. to keep the name a server moved from bancho.py had.
# TOMYUM_BANCHO__BOTNAME=BanchoBot

# Rankings' inactivity rule: a player with no score in a mode for this many days leaves that mode's
# rankings (website and in-game; the stats stay) until their next score. 0: off. osu!somtum uses 180,
# with the same number as TOMYUM_RANKING_INACTIVE_DAYS in osu-web.env.
# TOMYUM_RANKING__INACTIVEDAYS=0
