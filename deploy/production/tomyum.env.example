# TomYum settings beyond what docker-compose.yml sets from .env (config/.env.example lists them
# all). Copy to tomyum.env. The defaults are fine to start with.
TOMYUM_REPLAYS__PATH=data/replays

# The server's name in the Discord bot's posts, !version and the in-game restart notice
# ("example · TomYum 0.3.0-dev is up"); the website's is TOMYUM_SERVER_NAME in osu-web.env.
# Empty: TomYum.
TOMYUM_SERVER__NAME=

# Last.fm scrobbling (players connect it in the website's account settings). Make an API account at
# https://www.last.fm/api/account/create with the callback https://osu.<domain>/home/account/lastfm/callback.
# Empty: no Last.fm.
TOMYUM_LASTFM__APIKEY=
TOMYUM_LASTFM__APISECRET=

# osu!stable device verification (as osu.ppy.sh): logging in from a new device is refused until the
# player confirms it on the website (osu.<domain>/p/verify); an account's first device is trusted.
# TOMYUM_CLIENTVERIFICATION__ENABLED=true
