# The website's settings beyond what docker-compose.yml sets from .env. Copy to osu-web.env.
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=warning
LOG_CHANNEL=stderr

DB_DATABASE=osu
CACHE_DRIVER=redis
SESSION_DRIVER=redis
BROADCAST_DRIVER=redis
QUEUE_DRIVER=redis

# Behind Cloudflare and Caddy on the compose network: trust their X-Forwarded-* headers (so the
# site knows it is served over HTTPS; notifications need wss://). Not "*", which Symfony ignores.
TRUSTED_PROXIES=PRIVATE_SUBNETS

# TomYum
BANCHO_BOT_USER_ID=3
TOMYUM_MANAGES_RANKING=true
# Lazer builds aren't checked (players use the stock client with the injection ruleset).
CLIENT_CHECK_VERSION=false

# Sign-ups on the website (in-game registration always works).
REGISTRATION_MODE_WEB=true

# No email is sent unless you configure a mail server (MAIL_* settings): without one, skip the
# emailed login codes, or nobody can sign in from a new device.
USER_BYPASS_VERIFICATION=true

# Email (password resets, notifications). Proton Mail with your own domain: Settings > IMAP/SMTP >
# SMTP tokens, make a token for the address below (it must be one of your Proton addresses), and
# put it in MAIL_PASSWORD. Without these, mail is only written to the log.
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.protonmail.ch
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=noreply@example.com
# MAIL_PASSWORD=
# MAIL_ADDRESS=noreply@example.com
# MAIL_SENDER=osu!
# (Spacemail: MAIL_HOST=mail.spacemail.com, MAIL_PORT=465, MAIL_ENCRYPTION=ssl, the mailbox's address
# and password.)

# Support tickets (docs/tickets.md): support@, accounts@, appeal-review@, abuse@, privacy@, dmca@ and
# tournaments@ your domain, as aliases of the mailbox above, read over IMAP (TLS, port 993) with the
# same login. Spacemail: mail.spacemail.com.
# TICKETS_IMAP_HOST=

# Beatmap discussions (nominations reach the game through TomYum): how much hype a set needs before
# BNs can nominate it, how many nominations qualify it, and how many days it stays qualified before
# it's ranked. osu!'s numbers below; a small server may want less hype (0 turns hype off).
# BEATMAPSET_REQUIRED_HYPE=5
# BEATMAPSET_REQUIRED_NOMINATIONS=2
# BEATMAPSET_MINIMUM_DAYS_FOR_RANK=7
