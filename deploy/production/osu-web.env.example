# The website's settings beyond what docker-compose.yml sets from .env. Copy to osu-web.env.
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=warning
LOG_CHANNEL=stderr

DB_DATABASE=osu
CACHE_DRIVER=redis
SESSION_DRIVER=redis
BROADCAST_DRIVER=redis
QUEUE_CONNECTION=redis

# Behind Cloudflare and Caddy on the compose network: trust their X-Forwarded-* headers (so the
# site knows it is served over HTTPS; notifications need wss://). Not "*", which Symfony ignores.
TRUSTED_PROXIES=PRIVATE_SUBNETS

# TomYum
BANCHO_BOT_USER_ID=1
TOMYUM_MANAGES_RANKING=true
# Lazer builds aren't checked (players use the stock client with the injection ruleset).
CLIENT_CHECK_VERSION=false

# Sign-ups on the website (in-game registration always works).
REGISTRATION_MODE_WEB=true

# No email is sent unless you configure a mail server (MAIL_* settings): without one, skip the
# emailed login codes, or nobody can sign in from a new device.
USER_BYPASS_VERIFICATION=true
