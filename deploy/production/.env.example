# Production settings (docs/deploy-production.md). Copy to .env and fill in; keep it private.

# Your domain: the site is osu.<DOMAIN>, the game connects with -devserver <DOMAIN>.
DOMAIN=example.com

# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > "Install connector" (the token).
CLOUDFLARE_TUNNEL_TOKEN=

# Database passwords: long random strings (e.g. `openssl rand -hex 24`).
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Shared by TomYum, the website and ppy's services (e.g. `openssl rand -hex 32`).
SHARED_INTEROP_SECRET=

# The website's Laravel key: `docker compose run --rm artisan key:generate --show`.
OSU_WEB_APP_KEY=

# Where your osu-web fork is checked out, relative to this folder.
OSU_WEB_PATH=../../../osu-web
# Checkouts of sundeiii/tomyum-spectator and sundeiii/lazer-circleguard (private).
SPECTATOR_PATH=../../../tomyum-spectator
CIRCLEGUARD_PATH=../../../lazer-circleguard
# Shared by TomYum and circleguard (any long random string); empty turns replay checks off.
CIRCLEGUARD_KEY=

# osu! API (optional but recommended): v1 key from https://osu.ppy.sh/home/account/edit#legacy-api,
# v2 OAuth app from https://osu.ppy.sh/home/account/edit#oauth (descriptions, nominators).
OSU_API_KEY=
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# The website's red "This is a development instance" banner (off unless true).
DEVELOPMENT_BANNER=false

# TomYum.Gateway (docs/gateway.md): pre-2014 osu! builds' bancho over TCP (server.<domain>), and IRC
# when it runs on another box. GATEWAY_KEY is a long random secret shared with it
# (openssl rand -hex 32). To run it on this server, also set COMPOSE_PROFILES=gateway.
GATEWAY_KEY=
# COMPOSE_PROFILES=gateway
# GATEWAY_BANCHO_PORT=13381
