# Production routing behind a Cloudflare Tunnel (docs/deploy-production.md). Cloudflare ends
# HTTPS and sends every hostname to caddy:80 over the tunnel, so the sites here are plain HTTP.
# {$DOMAIN} is your domain (e.g. example.com): osu.example.com is the website, c./ce./c4. the
# game's bancho, a. avatars, spectator. lazer's multiplayer/spectating.
{
	auto_https off
	servers {
		# Only cloudflared (on the compose network) reaches this Caddy.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

(tomyum) {
	reverse_proxy server:8080 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-Proto https
	}
}

# Requests to the website/API and lazer's servers, for finding what clients ask for and don't get
# (deploy/production/misses.sh). The bancho hosts aren't logged: every player polls them each second.
(access-log) {
	log {
		output file /data/logs/access.log {
			roll_size 20MiB
			roll_keep 5
			roll_uncompressed
		}
		format json
	}
}

(osu-web) {
	reverse_proxy osu-web:8080 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
	}
}

# Game endpoints (bancho, beatmap assets, medal icons); s. is osu!'s old static host (old clients'
# medal images, docs/old-clients.md). Old clients reach all of these over plain HTTP: Cloudflare must
# not redirect them to HTTPS ("Always Use HTTPS" off, or a rule exempting these hosts).
http://c.{$DOMAIN}, http://c1.{$DOMAIN}, http://c2.{$DOMAIN}, http://c3.{$DOMAIN}, http://c4.{$DOMAIN}, http://c5.{$DOMAIN}, http://c6.{$DOMAIN}, http://ce.{$DOMAIN}, http://cho.{$DOMAIN}, http://b.{$DOMAIN}, http://assets.{$DOMAIN}, http://s.{$DOMAIN} {
	request_body {
		max_size 20MB
	}
	import tomyum
}

# Avatars (a.<domain>/<user id>): the website's uploads; users without one get its guest avatar.
http://a.{$DOMAIN} {
	import access-log
	header Cache-Control "no-cache"

	# /<id>, and /<id>.png, /<id>_<time>.png (what clients ask for; bancho.py serves them all).
	@user path_regexp user ^/([0-9]+)(?:[_.][^/]*)?$
	handle @user {
		rewrite * /uploads/avatar/{re.user.1}
		reverse_proxy osu-web:8080 {
			# Stored without an extension; browsers sniff the real format from any image/* type.
			header_down Content-Type image/png
			@missing status 404
			handle_response @missing {
				rewrite * /images/layout/avatar-guest@2x.png
				reverse_proxy osu-web:8080
			}
		}
	}
	handle {
		rewrite * /images/layout/avatar-guest@2x.png
		reverse_proxy osu-web:8080
	}
}

# osu.: the game client's /web/* and in-game registration go to TomYum, the website to osu-web.
http://osu.{$DOMAIN} {
	import access-log
	request_body {
		# Beatmap set uploads from the BN panel go up to 100 MB (Cloudflare's limit too).
		max_size 110MB
	}

	# The website's InterOp API is for TomYum and ppy's services on the compose network only.
	handle /_lio/* {
		respond 404
	}

	# Unknown country (XX) has no emoji flag: show the UN flag instead of a broken image.
	handle /assets/images/flags/1f1fd-1f1fd.svg {
		rewrite * /assets/images/flags/1f1fa-1f1f3.svg
		import osu-web
	}

	# Numbered builds' avatars (b1122, docs/old-clients.md): /forum/download.php?avatar=<id>.png,
	# the website's avatar (the guest one when there's none).
	@old-avatar {
		path /forum/download.php
		vars_regexp avatar {query.avatar} ^([0-9]+)
	}
	handle @old-avatar {
		rewrite * /uploads/avatar/{re.avatar.1}
		reverse_proxy osu-web:8080 {
			header_down Content-Type image/png
			@missing status 404
			handle_response @missing {
				rewrite * /images/layout/avatar-guest@2x.png
				reverse_proxy osu-web:8080
			}
		}
	}

	# Numbered builds' osu!direct (b1122): thumbnails (/images/map-thumb/<set>[l]) and previews
	# (/mp3/preview/<set>.mp3), served by TomYum's beatmap assets (b.<domain>).
	@old-thumb path_regexp old-thumb ^/images/map-thumb/([0-9]+)(l?)$
	handle @old-thumb {
		rewrite * /thumb/{re.old-thumb.1}{re.old-thumb.2}.jpg
		reverse_proxy server:8080 {
			header_up Host b.{$DOMAIN}
		}
	}
	@old-preview path_regexp old-preview ^/mp3/preview/([0-9]+)\.mp3$
	handle @old-preview {
		rewrite * /preview/{re.old-preview.1}.mp3
		reverse_proxy server:8080 {
			header_up Host b.{$DOMAIN}
		}
	}

	# /beatmap-submission: lazer's beatmap submission (its default, under the API URL).
	# /ss: stable's uploaded screenshots; /difficulty-rating: stable's star ratings with mods;
	# /release: old clients' update checks; /rating/ingame-rate2.php: numbered builds' beatmap rating
	# (docs/old-clients.md).
	@tomyum path /web/* /d/* /beatmap-submission/* /ss/* /difficulty-rating /release/* /rating/ingame-rate2.php
	handle @tomyum {
		import tomyum
	}
	# lazer sends the same User-Agent, but asks for JSON: its sign-up is the website's.
	@stable_register {
		method POST
		path /users
		header User-Agent osu!
		not header Accept application/json
	}
	handle @stable_register {
		import tomyum
	}

	# Lazer's hubs when it derives them from the API URL (<api>/signalr/<hub>).
	handle_path /signalr/* {
		reverse_proxy spectator:80
	}

	# Custom (uploaded) sets, ids from 10,000,000: TomYum has their covers and audio preview.
	@custom_set_files path_regexp ^/uploads/default/beatmaps/[0-9]{8,}/
	handle @custom_set_files {
		import tomyum
	}
	# Beatmap covers: the website links them under its uploads, but the official ones are on
	# ppy's asset server at the same path.
	@covers path_regexp covers ^/uploads/default/(beatmaps/[0-9]+/covers/.+)$
	handle @covers {
		redir https://assets.ppy.sh/{re.covers.1}
	}

	handle /uploads/avatar/* {
		reverse_proxy osu-web:8080 {
			header_down Content-Type image/png
		}
	}

	handle {
		import osu-web
	}

	encode gzip zstd
}

# Lazer's multiplayer, spectating and online presence (SignalR over WebSockets).
http://spectator.{$DOMAIN} {
	import access-log
	reverse_proxy spectator:80
}
