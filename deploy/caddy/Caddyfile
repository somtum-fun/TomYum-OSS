# TomYum edge configuration (Caddy, NOT nginx). Caddy fronts the server and proxies
# large asset downloads to object storage (R2 / OVH S3). Scaffold stub — replace
# example.com with your domain and adjust storage origins. The host routing here must
# match the in-code RequireHost constraints (see TomYum.Server/Bancho/BanchoHosts.cs and
# memories/protocols/bancho-stable.md §1).

# Bancho binary protocol. The osu!stable client connects to c.<domain> (older clients
# also use c4./ce.), and bancho-likes use cho.<domain>. All carry POST / login + polls.
c.example.com, c4.example.com, ce.example.com, cho.example.com {
	encode zstd gzip
	reverse_proxy tomyum-server:8080
}

# Web surface: /web/*.php, in-game registration (POST /users), osu!Direct, screenshots.
osu.example.com {
	encode zstd gzip

	# Health/liveness passthrough.
	handle /health {
		reverse_proxy tomyum-server:8080
	}

	# Everything else to the main server.
	reverse_proxy tomyum-server:8080
}

# Asset CDN front: serve beatmap sets / replays / avatars from object storage, with
# Caddy caching at the edge. Buckets are S3-compatible (R2, OVH). TODO: wire signed URLs.
assets.example.com {
	encode zstd gzip
	# reverse_proxy https://<bucket>.<r2-account>.r2.cloudflarestorage.com {
	#   header_up Host {http.reverse_proxy.upstream.hostport}
	# }
	respond "TomYum asset edge (configure storage origin)" 200
}
