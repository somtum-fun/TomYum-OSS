# Local testing (docs/local-testing.md): TomYum + osu-web on one machine, HTTPS from Caddy's own
# local certificate authority. `localtest.me` and every subdomain of it resolve to 127.0.0.1 in
# public DNS, so no hosts-file edits are needed. Run `caddy trust` once so Windows/macOS/Linux
# (and therefore osu! and your browser) trust these certificates.
#
# TomYum.Server on localhost:8080, osu-web's nginx on localhost:8180 (NGINX_PORT=8180), lazer's
# spectator server on localhost:8190.
{
	local_certs
}

# Game endpoints (bancho, beatmap assets, medal icons).
c.localtest.me, ce.localtest.me, c4.localtest.me, cho.localtest.me, b.localtest.me, assets.localtest.me {
	reverse_proxy localhost:8080
}

# Avatars (a.<domain>/<user id>, what the osu! client loads): osu-web stores uploads as
# /uploads/avatar/<user id>. Users without one get osu-web's guest avatar.
a.localtest.me {
	# Always revalidate so a new avatar shows up right away.
	header Cache-Control "no-cache"

	@user path_regexp user ^/([0-9]+)$
	handle @user {
		rewrite * /uploads/avatar/{re.user.1}
		reverse_proxy localhost:8180 {
			# The files have no extension, so they'd be served as a download; browsers sniff the
			# real format (png/jpeg/gif) from any image/* type and show it inline.
			header_down Content-Type image/png
			@missing status 404
			handle_response @missing {
				rewrite * /images/layout/avatar-guest@2x.png
				reverse_proxy localhost:8180
			}
		}
	}
	handle {
		rewrite * /images/layout/avatar-guest@2x.png
		reverse_proxy localhost:8180
	}
}

# osu.: the client's /web/* and in-game registration go to TomYum, the website to osu-web.
osu.localtest.me {
	@tomyum path /web/* /d/*
	@stable_register {
		method POST
		path /users
		header User-Agent osu!
	}
	handle @tomyum {
		reverse_proxy localhost:8080
	}
	handle @stable_register {
		reverse_proxy localhost:8080
	}
	# Beatmap covers: osu-web links them under its own uploads, but TomYum never stores any; the
	# official ones are on ppy's asset server at the same path.
	@covers path_regexp covers ^/uploads/default/(beatmaps/[0-9]+/covers/.+)$
	handle @covers {
		redir https://assets.ppy.sh/{re.covers.1}
	}
	# Extension-less avatar uploads: show them as images instead of downloading (see a. below).
	handle /uploads/avatar/* {
		reverse_proxy localhost:8180 {
			header_down Content-Type image/png
		}
	}
	handle {
		reverse_proxy localhost:8180
	}
}

# osu!(lazer)'s multiplayer, spectating and online presence (docs/lazer.md): ppy's spectator
# server in osu-web's compose, on localhost:8190 (SPECTATOR_PORT). SignalR over WebSockets.
spectator.localtest.me {
	reverse_proxy localhost:8190
}
