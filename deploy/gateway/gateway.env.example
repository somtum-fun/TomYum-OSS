# TomYum.Gateway on its own box (docs/gateway.md). Copy to gateway.env.

# The main server's domain: bancho is c.<domain>.
TOMYUM_GATEWAY__DOMAIN=example.com

# The secret shared with the main server: the same value as GATEWAY_KEY in its .env
# (openssl rand -hex 32).
TOMYUM_GATEWAY__KEY=

# Where the main server is. By default https://c.<domain> (through Cloudflare). Set it to reach the
# main server another way, e.g. over a private network: http://10.0.0.2:8880
# TOMYUM_GATEWAY__UPSTREAM=

# pre-2014 bancho over TCP (server.<domain>).
TOMYUM_GATEWAY__BANCHO__ENABLED=true

# IRC (irc.<domain>). Turn the main server's own IRC off when this takes it over (docs/gateway.md).
TOMYUM_GATEWAY__IRC__ENABLED=true

# Connections allowed at once from one address (bancho and IRC each).
# TOMYUM_GATEWAY__MAXCONNECTIONSPERIP=8
